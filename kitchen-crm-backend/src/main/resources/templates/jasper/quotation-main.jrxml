                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "quotation-kitchen.jasper"]]></subreportExpression>
            </subreport>
        </band>
    </detail>

    <columnFooter>
        <band height="0"/>
    </columnFooter>

    <!-- ============================================================ -->
    <!-- PAGE FOOTER — hidden on page 1, shown on pages 2+            -->
    <!-- ============================================================ -->
    <pageFooter>
        <band height="30">
            <rectangle>
                <reportElement x="0" y="0" width="595" height="30" backcolor="#1A1A1A" uuid="ee000001-0000-0000-0000-000000000002">
                    <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="225" y="4" width="145" height="18" uuid="ee000001-0000-0000-0000-000000000004">
                    <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{MAIN_LOGO} != null ? new java.io.ByteArrayInputStream((byte[])$P{MAIN_LOGO}) : null]]></imageExpression>
            </image>
            <textField>
                <reportElement x="405" y="4" width="180" height="20" forecolor="#FFFFFF" uuid="ee000001-0000-0000-0000-000000000005">
                    <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Right" verticalAlignment="Middle">
