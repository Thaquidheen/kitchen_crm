                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>

            <staticText>
                <reportElement x="20" y="360" width="100" height="20" forecolor="#666666" uuid="b1b2c3d4-e5f6-7890-abcd-ef1234567018"/>
                <textElement verticalAlignment="Middle">
                    <font size="10"/>
                </textElement>
                <text><![CDATA[Project:]]></text>
