    <!-- ============================================================ -->
    <!-- DETAIL BAND — Kitchen Subreport                              -->
    <!-- ============================================================ -->
    <detail>
        <band height="680" splitType="Stretch">
            <subreport>
                <reportElement x="0" y="0" width="595" height="680" uuid="dd000001-0000-0000-0000-000000000001"/>
                <subreportParameter name="SUBREPORT_DIR">
                    <subreportParameterExpression><![CDATA[$P{SUBREPORT_DIR}]]></subreportParameterExpression>
                </subreportParameter>
                <subreportParameter name="QUOTATION_NUMBER">
                    <subreportParameterExpression><![CDATA[$P{QUOTATION_NUMBER}]]></subreportParameterExpression>
