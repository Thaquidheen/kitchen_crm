            <textField>
                <reportElement x="120" y="360" width="375" height="20" forecolor="#333333" uuid="b1b2c3d4-e5f6-7890-abcd-ef1234567019"/>
                <textElement verticalAlignment="Middle">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PROJECT_NAME}]]></textFieldExpression>
