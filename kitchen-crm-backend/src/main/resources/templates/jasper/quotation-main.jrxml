            <!-- Header divider -->
            <line>
                <reportElement positionType="Float" x="30" y="5" width="535" height="1" forecolor="#CCCCCC" uuid="cf000001-0000-0000-0000-000000000027"/>
            </line>

            <!-- Row 1: BY ACCEPTANCE -->
            <frame>
                <reportElement positionType="Float" x="30" y="5" width="535" height="28" uuid="cf000001-0000-0000-0000-000000000030"/>
                <staticText>
                    <reportElement x="10" y="0" width="220" height="28" forecolor="#2C1810" uuid="cf000001-0000-0000-0000-000000000031"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Serif" size="10"/>
                    </textElement>
                    <text><![CDATA[By Acceptance]]></text>
                </staticText>
                <textField>
                    <reportElement x="240" y="0" width="60" height="28" forecolor="#2C1810" uuid="cf000001-0000-0000-0000-000000000032"/>
                    <textElement textAlignment="Center" verticalAlignment="Middle">
                        <font fontName="Serif" size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA[$P{PAYMENT_ACCEPTANCE_PCT}.intValue() + "%"]]></textFieldExpression>
                </textField>
                <textField>
                    <reportElement x="310" y="0" width="215" height="28" forecolor="#2C1810" uuid="cf000001-0000-0000-0000-000000000033"/>
                    <textElement textAlignment="Right" verticalAlignment="Middle">
                        <font fontName="Serif" size="10"/>
                    </textElement>
                    <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("en", "IN"))).format($P{GRAND_TOTAL}.multiply($P{PAYMENT_ACCEPTANCE_PCT}).divide(new java.math.BigDecimal(100)))]]></textFieldExpression>
                </textField>
            </frame>

            <!-- Row divider -->
            <line>
