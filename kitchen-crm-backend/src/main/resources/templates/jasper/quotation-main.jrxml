                    <font fontName="Serif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[PREPARED FOR]]></text>
            </staticText>
            <textField>
                <reportElement x="50" y="345" width="495" height="30" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000003"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="18" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_NAME}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="50" y="380" width="495" height="20" forecolor="#D4D0C8" uuid="bb000003-0000-0000-0000-000000000004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="11"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{PROJECT_NAME}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="50" y="400" width="495" height="16" forecolor="#D4D0C8" uuid="bb000003-0000-0000-0000-000000000005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CUSTOMER_ADDRESS}]]></textFieldExpression>
            </textField>

            <!-- Quotation Info — 3-column layout with headings -->
            <!-- Thin separator line -->
            <line>
                <reportElement x="80" y="415" width="435" height="1" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000010"/>
                <graphicElement><pen lineWidth="0.3" lineColor="#FFFFFF"/></graphicElement>
            </line>

            <!-- Column 1: QUOTATION NO -->
            <staticText>
                <reportElement x="50" y="425" width="165" height="16" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000011"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[QUOTATION NO]]></text>
            </staticText>
            <textField>
                <reportElement x="50" y="445" width="165" height="25" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{QUOTATION_NUMBER}]]></textFieldExpression>
            </textField>

            <!-- Column 2: DATE -->
            <staticText>
                <reportElement x="215" y="425" width="165" height="16" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[DATE]]></text>
            </staticText>
            <textField>
                <reportElement x="215" y="445" width="165" height="25" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{CREATED_DATE}]]></textFieldExpression>
            </textField>

            <!-- Column 3: QUOTE VALIDITY -->
            <staticText>
                <reportElement x="380" y="425" width="165" height="16" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000015"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[QUOTE VALIDITY]]></text>
            </staticText>
            <textField>
                <reportElement x="380" y="445" width="165" height="25" forecolor="#FFFFFF" uuid="bb000003-0000-0000-0000-000000000016"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{VALID_UNTIL}]]></textFieldExpression>
            </textField>
        </band>
