    <!-- ============================================================ -->
    <!-- SUMMARY BAND — Terms & Conditions                            -->
    <!-- ============================================================ -->
    <summary>
        <band height="842" splitType="Stretch">
            <break>
                <reportElement x="0" y="0" width="595" height="1" uuid="ff000001-0000-0000-0000-000000000001"/>
            </break>

            <!-- ===== Combined Kitchens Totals (only if > 1 kitchen) ===== -->
            <staticText>
                <reportElement positionType="Float" x="30" y="5" width="535" height="22" forecolor="#000000" uuid="cf000001-0000-0000-0000-000000000001">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="14" isBold="true" isUnderline="true"/>
                </textElement>
                <text><![CDATA[Final Summary]]></text>
            </staticText>

            <!-- Kitchen totals subreport (only if > 1 kitchen) -->
            <subreport>
                <reportElement positionType="Float" x="30" y="28" width="535" height="30" uuid="cf000001-0000-0000-0000-000000000002">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1 && $P{KITCHEN_TOTALS_DATA} != null]]></printWhenExpression>
                </reportElement>
                <dataSourceExpression><![CDATA[(net.sf.jasperreports.engine.JRDataSource)$P{KITCHEN_TOTALS_DATA}]]></dataSourceExpression>
                <subreportExpression><![CDATA[$P{SUBREPORT_DIR} + "subreport-kitchen-totals.jasper"]]></subreportExpression>
            </subreport>

            <!-- Miscellaneous row (only if > 1 kitchen and value > 0) -->
            <rectangle>
                <reportElement positionType="Float" x="30" y="60" width="535" height="25" backcolor="#FAF6F1" uuid="cf000002-0000-0000-0000-000000000001">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1 && $P{OTHER_EXPENSES_TOTAL} != null && $P{OTHER_EXPENSES_TOTAL}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement positionType="Float" x="40" y="60" width="250" height="25" forecolor="#2C1810" uuid="cf000002-0000-0000-0000-000000000002">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1 && $P{OTHER_EXPENSES_TOTAL} != null && $P{OTHER_EXPENSES_TOTAL}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <text><![CDATA[Miscellaneous]]></text>
            </staticText>
            <textField>
                <reportElement positionType="Float" x="310" y="60" width="255" height="25" forecolor="#2C1810" uuid="cf000002-0000-0000-0000-000000000003">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1 && $P{OTHER_EXPENSES_TOTAL} != null && $P{OTHER_EXPENSES_TOTAL}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("en", "IN"))).format($P{OTHER_EXPENSES_TOTAL})]]></textFieldExpression>
            </textField>

            <!-- Grand Total row (only if > 1 kitchen) -->
            <rectangle>
                <reportElement positionType="Float" x="30" y="90" width="535" height="30" backcolor="#000000" uuid="cf000001-0000-0000-0000-000000000003">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement positionType="Float" x="40" y="90" width="250" height="30" forecolor="#FFFFFF" uuid="cf000001-0000-0000-0000-000000000004">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[GRAND TOTAL]]></text>
            </staticText>
            <textField>
                <reportElement positionType="Float" x="310" y="90" width="255" height="30" forecolor="#FFFFFF" uuid="cf000001-0000-0000-0000-000000000005">
                    <printWhenExpression><![CDATA[$P{TOTAL_KITCHENS} > 1]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("#,##,##0.00", new java.text.DecimalFormatSymbols(new java.util.Locale("en", "IN"))).format($P{GRAND_TOTAL})]]></textFieldExpression>
            </textField>

            <!-- ===== NOTES (matching Important Note style) ===== -->
            <frame>
                <reportElement positionType="Float" x="30" y="5" width="535" height="28" uuid="cf000001-0000-0000-0000-0000000000a1">
                    <printWhenExpression><![CDATA[$P{NOTES} != null && !$P{NOTES}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <staticText>
                    <reportElement x="0" y="0" width="535" height="22" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-0000000000a3"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Serif" size="12" isBold="true"/>
                    </textElement>
                    <text><![CDATA[NOTES]]></text>
                </staticText>
                <line>
                    <reportElement x="0" y="24" width="535" height="1" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-0000000000a4"/>
                </line>
            </frame>
            <textField textAdjust="StretchHeight">
                <reportElement positionType="Float" x="30" y="5" width="535" height="20" forecolor="#333333" uuid="cf000001-0000-0000-0000-0000000000a2">
                    <printWhenExpression><![CDATA[$P{NOTES} != null && !$P{NOTES}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Top">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{NOTES}]]></textFieldExpression>
            </textField>

            <!-- ===== IMPORTANT NOTE (collapsible) ===== -->
            <frame>
                <reportElement positionType="Float" x="30" y="5" width="535" height="28" uuid="cf000001-0000-0000-0000-000000000010">
                    <printWhenExpression><![CDATA[$P{IMPORTANT_NOTE} != null && !$P{IMPORTANT_NOTE}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <staticText>
                    <reportElement x="0" y="0" width="535" height="22" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000011"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Serif" size="12" isBold="true"/>
                    </textElement>
                    <text><![CDATA[IMPORTANT NOTE]]></text>
                </staticText>
                <line>
                    <reportElement x="0" y="24" width="535" height="1" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000012"/>
                </line>
            </frame>
            <textField textAdjust="StretchHeight">
                <reportElement positionType="Float" x="30" y="5" width="535" height="20" forecolor="#333333" uuid="cf000001-0000-0000-0000-000000000013">
                    <printWhenExpression><![CDATA[$P{IMPORTANT_NOTE} != null && !$P{IMPORTANT_NOTE}.trim().isEmpty()]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Top">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$P{IMPORTANT_NOTE}]]></textFieldExpression>
            </textField>

            <!-- Divider between Important Note and Payment Terms -->
            <line>
                <reportElement positionType="Float" x="30" y="5" width="535" height="1" forecolor="#E0E0E0" uuid="cf000001-0000-0000-0000-000000000014"/>
            </line>

            <!-- ===== PAYMENT TERMS ===== -->
            <frame>
                <reportElement positionType="Float" x="30" y="5" width="535" height="28" uuid="cf000001-0000-0000-0000-000000000020"/>
                <staticText>
                    <reportElement x="0" y="0" width="535" height="22" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000021"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Serif" size="12" isBold="true"/>
                    </textElement>
                    <text><![CDATA[PAYMENT TERMS]]></text>
                </staticText>
                <line>
                    <reportElement x="0" y="24" width="535" height="1" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000022"/>
                </line>
            </frame>

            <!-- Table Header Row -->
            <frame>
                <reportElement positionType="Float" x="30" y="5" width="535" height="25" backcolor="#FAF6F1" uuid="cf000001-0000-0000-0000-000000000023" mode="Opaque"/>
                <staticText>
                    <reportElement x="10" y="0" width="220" height="25" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000024"/>
                    <textElement verticalAlignment="Middle">
                        <font fontName="Serif" size="10" isBold="true"/>
                    </textElement>
                    <text><![CDATA[Milestone]]></text>
                </staticText>
                <staticText>
                    <reportElement x="240" y="0" width="60" height="25" forecolor="#1B2A4A" uuid="cf000001-0000-0000-0000-000000000025"/>
