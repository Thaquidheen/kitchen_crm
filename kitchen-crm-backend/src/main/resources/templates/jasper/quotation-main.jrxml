    <!-- Background — dark on page 1 (behind kitchen image), cream on pages 2+ -->
    <background>
        <band height="842">
            <!-- Page 1: dark fill to match kitchen image edges -->
            <rectangle>
                <reportElement x="0" y="0" width="595" height="842" backcolor="#1A1A1A" uuid="aa000001-0000-0000-0000-000000000001">
                    <printWhenExpression><![CDATA[$V{PAGE_NUMBER} == 1]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Pages 2+: warm cream vignette background -->
            <image scaleImage="FillFrame" onErrorType="Blank">
                <reportElement x="0" y="0" width="595" height="842" uuid="aa000001-0000-0000-0000-000000000003">
                    <printWhenExpression><![CDATA[$V{PAGE_NUMBER} > 1]]></printWhenExpression>
                </reportElement>
                <imageExpression><![CDATA[$P{PAGE_BG} != null ? new java.io.ByteArrayInputStream((byte[])$P{PAGE_BG}) : null]]></imageExpression>
            </image>
        </band>
    </background>

    <!-- ============================================================ -->
    <!-- TITLE BAND — Cover Page (812px) — Kitchen Image Background   -->
    <!-- ============================================================ -->
    <title>
        <band height="812" splitType="Stretch">

            <!-- LAYER 1: Full-page kitchen background image -->
            <image scaleImage="FillFrame" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="0" y="0" width="595" height="812" uuid="bb000001-0000-0000-0000-000000000001"/>
                <imageExpression><![CDATA[$P{COVER_BG}]]></imageExpression>
            </image>

            <!-- LAYER 2: Text overlays on image -->

            <!-- A. TOP HEADER — logo over dark ceiling area -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="122" y="5" width="350" height="85" uuid="bb000001-0000-0000-0000-000000000002"/>
                <imageExpression><![CDATA[$P{MAIN_LOGO} != null ? new java.io.ByteArrayInputStream((byte[])$P{MAIN_LOGO}) : null]]></imageExpression>
            </image>
            <!-- B. MIDDLE TITLE — over dark cabinet area -->
            <staticText>
                <reportElement x="0" y="230" width="595" height="40" forecolor="#FFFFFF" uuid="bb000002-0000-0000-0000-000000000001"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="28" isBold="true"/>
                </textElement>
                <text><![CDATA[QUOTATION]]></text>
            </staticText>

            <!-- C. CUSTOMER INFO CARD — glassmorphism overlay -->
            <image scaleImage="FillFrame" onErrorType="Blank">
