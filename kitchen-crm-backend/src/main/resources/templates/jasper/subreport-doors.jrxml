<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-doors"
              pageWidth="595"
              pageHeight="400"
              columnWidth="595"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationDoorDto (standalone doors only) -->
    <field name="doorTypeName" class="java.lang.String"/>
    <field name="description" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="widthMm" class="java.lang.Integer"/>
    <field name="heightMm" class="java.lang.Integer"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="42">
            <rectangle radius="8">
                <reportElement x="15" y="10" width="565" height="32" backcolor="#000000" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567002"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="10" width="295" height="32" forecolor="#FFFFFF" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567003"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[DOOR TYPE]]></text>
            </staticText>
            <staticText>
                <reportElement x="320" y="10" width="50" height="32" forecolor="#FFFFFF" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[QTY]]></text>
            </staticText>
            <staticText>
                <reportElement x="375" y="10" width="80" height="32" forecolor="#FFFFFF" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[W(mm)]]></text>
            </staticText>
            <staticText>
                <reportElement x="465" y="10" width="105" height="32" forecolor="#FFFFFF" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567006"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[H(mm)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28" splitType="Stretch">
            <!-- White base background for ALL rows -->
            <rectangle>
                <reportElement x="15" y="0" width="565" height="28" backcolor="#FFFFFF" uuid="d0d1d2d3-e5f6-7890-abcd-ef12345670b1"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Alternating row highlight -->
            <rectangle>
                <reportElement x="15" y="0" width="565" height="28" backcolor="#FAF6F1" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567010">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="20" y="5" width="295" height="20" forecolor="#2C1810" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567011"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[($F{doorTypeName} != null && !$F{doorTypeName}.isEmpty()) ? $F{doorTypeName} : $F{description}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="320" y="5" width="50" height="20" forecolor="#2C1810" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="375" y="5" width="80" height="20" forecolor="#2C1810" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{widthMm}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="465" y="5" width="105" height="20" forecolor="#2C1810" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{heightMm}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="15" y="27" width="565" height="1" forecolor="#E8E0D5" uuid="d0d1d2d3-e5f6-7890-abcd-ef1234567018"/>
            </line>
        </band>
    </detail>

</jasperReport>
