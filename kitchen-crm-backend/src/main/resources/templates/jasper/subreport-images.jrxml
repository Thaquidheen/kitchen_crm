<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-images"
              pageWidth="515"
              pageHeight="400"
              columnWidth="250"
              columnCount="2"
              columnSpacing="15"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="images-subreport-uuid">

    <!-- Fields from QuotationKitchenPlanImageDto -->
    <field name="imageName" class="java.lang.String"/>
    <field name="imageBase64" class="java.lang.String"/>
    <field name="imageOrder" class="java.lang.Integer"/>

    <detail>
        <band height="180" splitType="Prevent">
            <!-- Image Container -->
            <rectangle radius="5">
                <reportElement x="0" y="0" width="250" height="175" backcolor="#FFFFFF" uuid="image-container"/>
                <graphicElement><pen lineWidth="1" lineColor="#DDDDDD"/></graphicElement>
            </rectangle>

            <!-- Image -->
            <image scaleImage="RetainShape" hAlign="Center" vAlign="Middle" onErrorType="Blank">
                <reportElement x="5" y="5" width="240" height="145" uuid="plan-image"/>
                <imageExpression><![CDATA[$F{imageBase64} != null ? new java.io.ByteArrayInputStream(java.util.Base64.getDecoder().decode($F{imageBase64})) : null]]></imageExpression>
            </image>

            <!-- Image Name -->
            <textField textAdjust="StretchHeight">
                <reportElement x="5" y="155" width="240" height="15" forecolor="#666666" uuid="image-name"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{imageName} != null ? $F{imageName} : "Plan Image " + $F{imageOrder}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <noData>
        <band height="40">
            <staticText>
                <reportElement x="0" y="10" width="515" height="20" forecolor="#999999" uuid="no-images"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="10" isItalic="true"/>
                </textElement>
                <text><![CDATA[No plan images available for this kitchen]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
