<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-products"
              pageWidth="595"
              pageHeight="400"
              columnWidth="595"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationCabinetDto -->
    <field name="cabinetTypeName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="widthMm" class="java.lang.Integer"/>
    <field name="depthMm" class="java.lang.Integer"/>
    <field name="heightMm" class="java.lang.Integer"/>
    <field name="brandName" class="java.lang.String"/>
    <field name="materialName" class="java.lang.String"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <title>
        <band height="22">
            <rectangle>
                <reportElement x="15" y="0" width="4" height="18" backcolor="#8B0000" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567a01"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="27" y="0" width="510" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567001"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[CABINETS]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="32">
            <rectangle radius="8">
                <reportElement x="15" y="0" width="565" height="32" backcolor="#000000" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567002"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="0" width="250" height="32" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567003"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[CABINET TYPE]]></text>
            </staticText>
            <staticText>
                <reportElement x="275" y="0" width="60" height="32" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[QTY]]></text>
            </staticText>
            <staticText>
                <reportElement x="340" y="0" width="70" height="32" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[W(MM)]]></text>
            </staticText>
            <staticText>
                <reportElement x="415" y="0" width="70" height="32" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567006"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[D(MM)]]></text>
            </staticText>
            <staticText>
                <reportElement x="490" y="0" width="80" height="32" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567007"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[H(MM)]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28" splitType="Stretch">
            <!-- White base background for ALL rows -->
            <rectangle>
                <reportElement x="15" y="0" width="565" height="28" backcolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef12345670b1"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Alternating row highlight -->
            <rectangle>
                <reportElement x="15" y="0" width="565" height="28" backcolor="#FAF6F1" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567010">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="20" y="5" width="250" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567011"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cabinetTypeName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="275" y="5" width="60" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="340" y="5" width="70" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{widthMm}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="415" y="5" width="70" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{depthMm}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="490" y="5" width="80" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567015"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{heightMm}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="15" y="27" width="565" height="1" forecolor="#E8E0D5" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567018"/>
            </line>
        </band>
    </detail>

    <noData>
        <band height="30">
            <rectangle>
                <reportElement x="15" y="5" width="3" height="20" backcolor="#E8E0D5" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567a02"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="25" y="5" width="525" height="20" forecolor="#8B7355" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567019"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[No cabinets in this kitchen]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
