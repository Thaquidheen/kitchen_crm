<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-products"
              pageWidth="575"
              pageHeight="400"
              columnWidth="575"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationCabinetDto -->
    <field name="cabinetTypeName" class="java.lang.String"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="widthMm" class="java.lang.Integer"/>
    <field name="depthMm" class="java.lang.Integer"/>
    <field name="heightMm" class="java.lang.Integer"/>
    <field name="brandName" class="java.lang.String"/>
    <field name="materialName" class="java.lang.String"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <title>
        <band height="22">
            <rectangle>
                <reportElement x="0" y="0" width="4" height="18" backcolor="#C8A45D" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567a01"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="12" y="0" width="503" height="20" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567001"/>
                <textElement verticalAlignment="Middle">
                    <font size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Cabinets]]></text>
            </staticText>
        </band>
    </title>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="575" height="25" backcolor="#3B2820" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567002"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="0" width="150" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567003"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Cabinet Type]]></text>
            </staticText>
            <staticText>
                <reportElement x="160" y="0" width="35" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567004"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="200" y="0" width="50" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567005"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[W(mm)]]></text>
            </staticText>
            <staticText>
                <reportElement x="255" y="0" width="50" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567006"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[D(mm)]]></text>
            </staticText>
            <staticText>
                <reportElement x="310" y="0" width="50" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567007"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[H(mm)]]></text>
            </staticText>
            <staticText>
                <reportElement x="365" y="0" width="70" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567008"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Brand]]></text>
            </staticText>
            <staticText>
                <reportElement x="440" y="0" width="70" height="25" forecolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567009"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Material]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20" splitType="Stretch">
            <!-- White base background for ALL rows -->
            <rectangle>
                <reportElement x="0" y="0" width="575" height="20" backcolor="#FFFFFF" uuid="f1f2f3f4-e5f6-7890-abcd-ef12345670b1"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Alternating row highlight -->
            <rectangle>
                <reportElement x="0" y="0" width="575" height="20" backcolor="#FAF6F1" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567010">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="5" y="2" width="150" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567011"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cabinetTypeName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="160" y="2" width="35" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567012"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="200" y="2" width="50" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567013"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{widthMm}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="255" y="2" width="50" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567014"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{depthMm}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="310" y="2" width="50" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567015"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{heightMm}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="365" y="2" width="70" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567016"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{brandName}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="440" y="2" width="70" height="16" forecolor="#2C1810" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567017"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{materialName}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="19" width="575" height="1" forecolor="#E8E0D5" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567018"/>
            </line>
        </band>
    </detail>

    <noData>
        <band height="30">
            <rectangle>
                <reportElement x="0" y="5" width="3" height="20" backcolor="#E8E0D5" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567a02"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="5" width="505" height="20" forecolor="#8B7355" uuid="f1f2f3f4-e5f6-7890-abcd-ef1234567019"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[No cabinets in this kitchen]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
