              name="subreport-lighting"
              pageWidth="515"
              pageHeight="300"
              columnWidth="515"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationLightingDto -->
    <field name="itemName" class="java.lang.String"/>
