<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-lighting"
              pageWidth="575"
              pageHeight="300"
              columnWidth="575"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationLightingDto -->
    <field name="itemName" class="java.lang.String"/>
    <field name="quantity" class="java.math.BigDecimal"/>
    <field name="unit" class="java.lang.String"/>
    <field name="specifications" class="java.lang.String"/>
    <field name="itemType" class="java.lang.String"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="32">
            <rectangle radius="8">
                <reportElement x="15" y="0" width="545" height="32" backcolor="#000000" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567001"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="20" y="0" width="180" height="32" forecolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567002"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[ITEM NAME]]></text>
            </staticText>
            <staticText>
                <reportElement x="205" y="0" width="50" height="32" forecolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567003"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[QTY]]></text>
            </staticText>
            <staticText>
                <reportElement x="260" y="0" width="60" height="32" forecolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567004"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[UNIT]]></text>
            </staticText>
            <staticText>
                <reportElement x="325" y="0" width="120" height="32" forecolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567005"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[SPECIFICATIONS]]></text>
            </staticText>
            <staticText>
                <reportElement x="450" y="0" width="75" height="32" forecolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567006"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[TYPE]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="28" splitType="Stretch">
            <!-- White base background for ALL rows -->
            <rectangle>
                <reportElement x="15" y="0" width="545" height="28" backcolor="#FFFFFF" uuid="b1b2b3b4-c5c6-7890-abcd-ef12345670b1"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Alternating row highlight -->
            <rectangle>
                <reportElement x="15" y="0" width="545" height="28" backcolor="#FAF6F1" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567007">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="20" y="5" width="180" height="20" forecolor="#2C1810" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567008"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true" pattern="#,##0.##">
                <reportElement x="205" y="5" width="50" height="20" forecolor="#2C1810" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567009"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="260" y="5" width="60" height="20" forecolor="#2C1810" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567010"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{unit} != null ? $F{unit} : "Pieces"]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="325" y="5" width="120" height="20" forecolor="#8B7355" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567011"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{specifications}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="450" y="5" width="75" height="20" forecolor="#2C1810" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567012"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{itemType}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="15" y="27" width="545" height="1" forecolor="#E8E0D5" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567013"/>
            </line>
        </band>
    </detail>

    <noData>
        <band height="30">
            <rectangle>
                <reportElement x="15" y="5" width="3" height="20" backcolor="#E8E0D5" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567a01"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="25" y="5" width="505" height="20" forecolor="#8B7355" uuid="b1b2b3b4-c5c6-7890-abcd-ef1234567014"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[No lighting items in this kitchen]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
