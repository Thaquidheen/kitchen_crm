<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-scope"
              pageWidth="575"
              pageHeight="400"
              columnWidth="575"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567890">

    <!-- Fields from QuotationKitchenScopeDetailDto -->
    <field name="fieldName" class="java.lang.String"/>
    <field name="fieldValue" class="java.lang.String"/>
    <field name="fieldOrder" class="java.lang.Integer"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="575" height="25" backcolor="#3B2820" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567001"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="10" y="0" width="200" height="25" forecolor="#FFFFFF" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567002"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Specification]]></text>
            </staticText>
            <staticText>
                <reportElement x="220" y="0" width="345" height="25" forecolor="#FFFFFF" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567003"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Details]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <!-- White base background for ALL rows (covers bg.jpg) -->
            <rectangle>
                <reportElement x="0" y="0" width="575" height="22" backcolor="#FFFFFF" uuid="d1d2d3d4-e5f6-7890-abcd-ef12345670b1"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <!-- Alternating row highlight -->
            <rectangle>
                <reportElement x="0" y="0" width="575" height="22" backcolor="#FAF6F1" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567004">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight">
                <reportElement x="10" y="2" width="200" height="18" forecolor="#8B7355" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567005"/>
                <textElement verticalAlignment="Middle">
                    <font size="9"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fieldName}]]></textFieldExpression>
            </textField>

            <textField textAdjust="StretchHeight">
                <reportElement x="220" y="2" width="345" height="18" forecolor="#2C1810" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567006"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fieldValue}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="21" width="575" height="1" forecolor="#E8E0D5" uuid="d1d2d3d4-e5f6-7890-abcd-ef1234567007"/>
            </line>
        </band>
    </detail>

</jasperReport>
