<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="subreport-accessories"
              pageWidth="515"
              pageHeight="300"
              columnWidth="515"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="accessories-subreport-uuid">

    <!-- Fields from QuotationAccessoryDto -->
    <field name="accessoryName" class="java.lang.String"/>
    <field name="customItemName" class="java.lang.String"/>
    <field name="customItem" class="java.lang.Boolean"/>
    <field name="quantity" class="java.lang.Integer"/>
    <field name="description" class="java.lang.String"/>
    <field name="brandName" class="java.lang.String"/>

    <variable name="ROW_NUMBER" class="java.lang.Integer" calculation="Count">
        <variableExpression><![CDATA[Boolean.TRUE]]></variableExpression>
    </variable>

    <columnHeader>
        <band height="25">
            <rectangle>
                <reportElement x="0" y="0" width="515" height="25" backcolor="#1E3A5F" uuid="acc-header-bg"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="0" width="180" height="25" forecolor="#FFFFFF" uuid="item-header"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Item / Description]]></text>
            </staticText>
            <staticText>
                <reportElement x="190" y="0" width="40" height="25" forecolor="#FFFFFF" uuid="qty-header"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Qty]]></text>
            </staticText>
            <staticText>
                <reportElement x="235" y="0" width="180" height="25" forecolor="#FFFFFF" uuid="details-header"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Details]]></text>
            </staticText>
            <staticText>
                <reportElement x="420" y="0" width="90" height="25" forecolor="#FFFFFF" uuid="brand-header"/>
                <textElement verticalAlignment="Middle">
                    <font size="8" isBold="true"/>
                </textElement>
                <text><![CDATA[Brand]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="22" splitType="Stretch">
            <!-- Alternating row background -->
            <rectangle>
                <reportElement x="0" y="0" width="515" height="22" backcolor="#F9FAFB" uuid="alt-row-bg">
                    <printWhenExpression><![CDATA[$V{ROW_NUMBER} % 2 == 0]]></printWhenExpression>
                </reportElement>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>

            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="5" y="2" width="180" height="18" forecolor="#333333" uuid="acc-name"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{customItem} != null && $F{customItem} ? $F{customItemName} : $F{accessoryName}]]></textFieldExpression>
            </textField>
            <textField isBlankWhenNull="true">
                <reportElement x="190" y="2" width="40" height="18" forecolor="#333333" uuid="acc-qty"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{quantity}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="235" y="2" width="180" height="18" forecolor="#666666" uuid="acc-desc"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{description}]]></textFieldExpression>
            </textField>
            <textField textAdjust="StretchHeight" isBlankWhenNull="true">
                <reportElement x="420" y="2" width="90" height="18" forecolor="#333333" uuid="acc-brand"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{brandName}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="0" y="21" width="515" height="1" forecolor="#EEEEEE" uuid="row-divider"/>
            </line>
        </band>
    </detail>

    <noData>
        <band height="30">
            <staticText>
                <reportElement x="0" y="5" width="515" height="20" forecolor="#999999" uuid="no-accessories"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isItalic="true"/>
                </textElement>
                <text><![CDATA[No accessories in this kitchen]]></text>
            </staticText>
        </band>
    </noData>

</jasperReport>
