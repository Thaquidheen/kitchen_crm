<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="quotation-grand-summary"
              pageWidth="565"
              pageHeight="400"
              columnWidth="565"
              leftMargin="0"
              rightMargin="0"
              topMargin="0"
              bottomMargin="0"
              uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50001">

    <parameter name="GRAND_TOTAL" class="java.math.BigDecimal"/>
    <parameter name="OTHER_EXPENSES_TOTAL" class="java.math.BigDecimal"/>
    <parameter name="COMMON_TRANSPORTATION" class="java.math.BigDecimal"/>
    <parameter name="MRP_FINAL" class="java.math.BigDecimal"/>

    <field name="kitchenName" class="java.lang.String"/>
    <field name="totalAmount" class="java.math.BigDecimal"/>

    <columnHeader>
        <band height="35">
            <!-- Grand Total Summary title -->
            <staticText>
                <reportElement x="0" y="0" width="350" height="22" forecolor="#1A1A1A" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50002"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Grand Total Summary]]></text>
            </staticText>
            <!-- Separator line below title -->
            <line>
                <reportElement x="0" y="28" width="545" height="1" forecolor="#CCCCCC" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50003"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
        </band>
    </columnHeader>

    <detail>
        <band height="22">
            <!-- Kitchen name -->
            <textField>
                <reportElement x="5" y="0" width="350" height="20" forecolor="#333333" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50004"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{kitchenName}]]></textFieldExpression>
            </textField>
            <!-- Kitchen total -->
            <textField>
                <reportElement x="355" y="0" width="190" height="20" forecolor="#333333" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50005"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("0.00").format($F{totalAmount}).replaceAll("(\\d)(?=(\\d\\d)+\\d\\.)", "$1,")]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <summary>
        <band height="106">
            <!-- Separator line above grand total -->
            <line>
                <reportElement x="0" y="2" width="545" height="1" forecolor="#CCCCCC" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50006"/>
                <graphicElement><pen lineWidth="0.5"/></graphicElement>
            </line>
            <!-- Transportation (common) line — single charge for the whole quotation (conditional) -->
            <staticText>
                <reportElement x="5" y="8" width="350" height="20" forecolor="#333333" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50011">
                    <printWhenExpression><![CDATA[$P{COMMON_TRANSPORTATION} != null && $P{COMMON_TRANSPORTATION}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <text><![CDATA[Transportation (common)]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="8" width="190" height="20" forecolor="#333333" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50012">
                    <printWhenExpression><![CDATA[$P{COMMON_TRANSPORTATION} != null && $P{COMMON_TRANSPORTATION}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("0.00").format($P{COMMON_TRANSPORTATION}).replaceAll("(\\d)(?=(\\d\\d)+\\d\\.)", "$1,")]]></textFieldExpression>
            </textField>
            <!-- Incl. Other Expenses note (conditional) -->
            <textField>
                <reportElement x="5" y="28" width="350" height="14" forecolor="#777777" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50007">
                    <printWhenExpression><![CDATA[$P{OTHER_EXPENSES_TOTAL} != null && $P{OTHER_EXPENSES_TOTAL}.compareTo(java.math.BigDecimal.ZERO) > 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="8" isItalic="true"/>
                </textElement>
                <textFieldExpression><![CDATA["(Incl. per-kitchen Other Expenses: Rs. " + new java.text.DecimalFormat("0.00").format($P{OTHER_EXPENSES_TOTAL}).replaceAll("(\\d)(?=(\\d\\d)+\\d\\.)", "$1,") + ")"]]></textFieldExpression>
            </textField>
            <!-- MRP (list price), struck-through, shown above the Offer Price (only when > Offer) -->
            <staticText>
                <reportElement x="5" y="44" width="200" height="20" forecolor="#888888" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50013">
                    <printWhenExpression><![CDATA[$P{MRP_FINAL} != null && $P{GRAND_TOTAL} != null && $P{MRP_FINAL}.compareTo($P{GRAND_TOTAL}) > 0]]></printWhenExpression>
                </reportElement>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="10"/>
                </textElement>
                <text><![CDATA[MRP]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="44" width="190" height="20" forecolor="#888888" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50014">
                    <printWhenExpression><![CDATA[$P{MRP_FINAL} != null && $P{GRAND_TOTAL} != null && $P{MRP_FINAL}.compareTo($P{GRAND_TOTAL}) > 0]]></printWhenExpression>
                </reportElement>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="11" isStrikeThrough="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("0.00").format($P{MRP_FINAL}).replaceAll("(\\d)(?=(\\d\\d)+\\d\\.)", "$1,")]]></textFieldExpression>
            </textField>
            <!-- Offer Price black bar (the current grand total) -->
            <rectangle>
                <reportElement x="0" y="68" width="545" height="35" backcolor="#000000" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50008"/>
                <graphicElement><pen lineWidth="0"/></graphicElement>
            </rectangle>
            <staticText>
                <reportElement x="5" y="73" width="350" height="25" forecolor="#FFFFFF" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50009"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="Serif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[OFFER PRICE]]></text>
            </staticText>
            <textField>
                <reportElement x="355" y="73" width="185" height="25" forecolor="#FFFFFF" uuid="a1a1a1a1-b2b2-c3c3-d4d4-e5e5e5e50010"/>
                <textElement textAlignment="Left" verticalAlignment="Middle">
                    <font fontName="Serif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Rs. " + new java.text.DecimalFormat("0.00").format($P{GRAND_TOTAL}).replaceAll("(\\d)(?=(\\d\\d)+\\d\\.)", "$1,")]]></textFieldExpression>
            </textField>
        </band>
    </summary>

</jasperReport>
