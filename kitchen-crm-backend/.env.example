# ==========================================
# Kitchen CRM - Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit .env file to Git!
# ==========================================

# ==========================================
# Database Configuration
# ==========================================
DB_USERNAME=kitchen_crm
DB_PASSWORD=your-database-password-here

# ==========================================
# JWT Security
# ==========================================
JWT_SECRET=your-jwt-secret-key-here-at-least-32-characters-long

# ==========================================
# Email Configuration - Gmail SMTP Only
# ==========================================
# 1. Enable 2-Step Verification: https://myaccount.google.com/security
# 2. Generate App Password: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (remove spaces)

EMAIL_ENABLED=true
GMAIL_USERNAME=thaquidheen@gmail.com
GMAIL_APP_PASSWORD=xfhemzassuywbyvu
EMAIL_FROM_NAME=Kitchen CRM

# Optional: Override from email (defaults to GMAIL_USERNAME)
# GMAIL_FROM_EMAIL=custom-sender@gmail.com

# ==========================================
# Digital Signature Configuration
# ==========================================
# Base URL where customers will access approval links
# Development: http://localhost:5173
# Production: https://yourcompany.com

SIGNATURE_BASE_URL=http://localhost:5173

# ==========================================
# File Upload Configuration
# ==========================================
FILE_UPLOAD_DIR=./uploads

# ==========================================
# Margin Configuration
# ==========================================
DEFAULT_MARGIN=15.0

# ==========================================
# SETUP INSTRUCTIONS
# ==========================================

# Gmail SMTP Setup:
# -----------------
# Time: 15-20 minutes
# Cost: FREE (500 emails/day)
# Guide: GMAIL_SMTP_SETUP_GUIDE.md
#
# Quick Steps:
# 1. Enable 2-Step Verification on Gmail
# 2. Generate App Password
# 3. Copy 16-character password (remove spaces)
# 4. Set GMAIL_USERNAME and GMAIL_APP_PASSWORD above

# ==========================================
# SECURITY REMINDERS
# ==========================================
#
# ✓ Add .env to .gitignore (NEVER commit to Git)
# ✓ Use strong, unique passwords
# ✓ Rotate credentials every 6 months
# ✓ Use environment variables in production
# ✓ Store credentials in password manager
# ✓ Enable 2-Step Verification on all accounts
#
# ==========================================

# ==========================================
# VERIFICATION
# ==========================================
#
# After configuration:
# 1. Start backend: ./mvnw spring-boot:run
# 2. Check logs for:
#    - "Email service enabled: Gmail SMTP" ✓
#    - "WhatsApp service enabled: Business API" ✓
# 3. Test by sending quotation for signature
# 4. Verify email and WhatsApp received
#
# ==========================================

# ==========================================
# COST SUMMARY (Monthly)
# ==========================================
#
# Gmail SMTP:        FREE (up to 500 emails/day)
# Total:             ₹0
#
# Compare to:
# SendGrid:          ₹1,500/month
# Savings:           ₹1,500/month
#
# ==========================================

